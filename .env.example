# Your Courier API key, from https://app.courier.com/settings/api-keys
# Copy this file to .env and fill it in. A Test key is fine.
COURIER_API_KEY=YOUR_COURIER_API_KEY

# The subscription topic these notifications belong to, from Platform > Preferences
# (https://app.courier.com/~/test/platform/preferences). Users opt in or out of it.
COURIER_TOPIC_ID=YOUR_TOPIC_ID

# Where bin/rails courier:send delivers. In Test, use the email you log in to
# Courier with: the Courier Test Email Provider only delivers to teammates.
DEMO_EMAIL=you@example.com

# Optional. An E.164 number, such as +12025550156. SMS also needs an SMS
# provider such as Twilio connected in Courier.
DEMO_PHONE=
